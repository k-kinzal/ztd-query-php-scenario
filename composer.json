{
    "name": "k-kinzal/ztd-query-php-scenario",
    "description": "AI-operated scenario factory, example repository, and lightweight contract suite for ztd-query-php adapters.",
    "type": "project",
    "keywords": [
        "ztd-query",
        "example",
        "contract-testing",
        "phpunit",
        "testcontainers",
        "mysqli",
        "pdo",
        "ears"
    ],
    "license": "proprietary",
    "autoload": {},
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "k-kinzal",
            "email": "keen.flag7803@logn.in"
        }
    ],
    "require-dev": {
